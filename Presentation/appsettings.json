{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "BILBOARD_DB_CONNECTION"
  },
  "JwtSettings": {
    "Secret": "JWT_SECRET",
    "Issuer": "BilboardAPI",
    "Audience": "BilboardClient",
    "ExpirationMinutes": 20
  },
  "ClientSettings": {
    "BaseUrl": "https://bilboard.online"
  },
  "Brevo": {
    "ApiKey": "YOUR_BREVO_API_KEY",
    "SenderEmail": "verify@bilboard.online",
    "SenderName": "Bilboard"
  },
  "AllowedHosts": "*"
}