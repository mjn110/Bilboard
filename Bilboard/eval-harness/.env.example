# Copy to .env and fill in.

# Where the Blazor Server app is listening (see Properties/launchSettings.json).
BILBOARD_EVAL_URL=https://localhost:7162

# Must match Evaluation:ApiKey in appsettings.Development.json.
BILBOARD_EVAL_KEY=bilboard-local-eval-key

# Optional: override the chat model Bilboard uses for this run.
# BILBOARD_EVAL_MODEL=gpt-4o-mini

# Only needed for the optional readability checks (--vision-model openai|azure).
# OPENAI_API_KEY=sk-...
# AZURE_OPENAI_ENDPOINT=https://xxx.openai.azure.com/
# OPENAI_API_VERSION=2024-08-01-preview
